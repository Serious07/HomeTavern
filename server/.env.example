# ============================================
# HomeTavern Server Configuration
# ============================================

# Server settings
PORT=4000
CORS_ORIGIN=*

# Database
DB_PATH=./hometavern.db

# Admin user (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# LLM Settings (llama.cpp server or cloud provider)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen-3.5
LLM_API_KEY=local-model-key
LLM_MAX_TOKENS=64000
LLM_MAX_CONTEXT_LENGTH=131072

# Translation Settings
TRANSLATION_PROVIDER=libretranslate
TRANSLATION_API_KEY=

# ============================================
# Prompt Debug (for hybrid model caching diagnostics)
# ============================================
# Enable prompt hashing and comparison between requests.
# Critical for qwen35moe (hybrid MoE) models that require
# bit-for-bit identical prompts for KV-cache recovery.
#
# When enabled:
# - Logs MD5 hash of each prompt before sending to llama-server
# - Compares with previous request's hash for the same chat
# - Requests /tokenize endpoint for token-level analysis
# - Writes detailed logs to /tmp/hometavern_prompt_debug.log
#
# Set to 'true' only when debugging caching issues!
ENABLE_PROMPT_DEBUG=false